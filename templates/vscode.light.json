		"settings.dropdownBackground": "${$color.surface.chrome}",
		"settings.dropdownForeground": "${$color.fg.default}",
		"settings.headerForeground": "${$color.fg.emphasis}",
		"settings.modifiedItemIndicator": "${$color.fg.emphasis}",
		"settings.numberInputBackground": "${$color.surface.chrome}",
