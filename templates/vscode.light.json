		"statusBarItem.remoteForeground": "${$color.fg.on-accent}",
		"tab.activeBackground": "${$color.surface.active}",
		"tab.activeBorder": "${$color.stroke.emphasis}",
		"tab.activeForeground": "${$color.fg.on-dark}",
		"tab.activeModifiedBorder": "${$color.state.modified}",
		"tab.border": "${$color.surface.chrome}",
		"tab.hoverBackground": "${$color.surface.hover}",
		"tab.inactiveBackground": "${$color.surface.chrome}",
		"tab.inactiveForeground": "${$color.fg.muted}",
		"tab.inactiveModifiedBorder": "${$color.state.modified}",
		"tab.unfocusedActiveBorder": "${$color.stroke.emphasis-muted}",
		"tab.unfocusedActiveForeground": "${$color.fg.default}",
		"tab.unfocusedActiveModifiedBorder": "${$color.state.modified}",
		"tab.unfocusedInactiveModifiedBorder": "${$color.state.modified}",
		"terminal.ansiBlack": "${$color.ansi.black}",
		"terminal.ansiBlue": "${$color.ansi.blue}",
		"terminal.ansiBrightBlack": "${$color.ansi.bright-black}",
		"terminal.ansiBrightBlue": "${$color.ansi.bright-blue}",
		"terminal.ansiBrightCyan": "${$color.ansi.bright-cyan}",
		"terminal.ansiBrightGreen": "${$color.ansi.bright-green}",
		"terminal.ansiBrightMagenta": "${$color.ansi.bright-magenta}",
		"terminal.ansiBrightRed": "${$color.ansi.bright-red}",
		"terminal.ansiBrightWhite": "${$color.ansi.bright-white}",
		"terminal.ansiBrightYellow": "${$color.ansi.bright-yellow}",
		"terminal.ansiCyan": "${$color.ansi.cyan}",
		"terminal.ansiGreen": "${$color.ansi.green}",
		"terminal.ansiMagenta": "${$color.ansi.magenta}",
		"terminal.ansiRed": "${$color.ansi.red}",
		"terminal.ansiWhite": "${$color.ansi.white}",
		"terminal.ansiYellow": "${$color.ansi.yellow}",
		"terminal.background": "${$color.surface.chrome}",
		"terminal.foreground": "${$color.fg.default}",
		"terminal.selectionBackground": "${$color.highlight.selection/26}",
		"terminalCursor.background": "${$color.fg.on-accent}",
		"terminalCursor.foreground": "${$color.caret.default}",
		"textLink.activeForeground": "${$color.fg.default}",
