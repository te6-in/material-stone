		"sideBarTitle.foreground": "${$color.fg.default}",
		"statusBar.background": "${$color.surface.canvas}",
		"statusBar.border": "${$color.stroke.default/60}",
		"statusBar.debuggingBackground": "${$color.spectrum.purple}",
		"statusBar.debuggingForeground": "${$color.fg.on-dark}",
		"statusBar.foreground": "${$color.fg.dim}",
		"statusBar.noFolderBackground": "${$color.surface.raised}",
		"statusBarItem.activeBackground": "${$color.spectrum.red/80}",
		"statusBarItem.hoverBackground": "${$color.surface.hover-muted}",
