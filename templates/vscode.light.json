	"semanticTokenColors": {
		"*.deprecated": { "strikethrough": true },
		"*.defaultLibrary": { "italic": true },
		"*.async": { "italic": true },
		"function": "${$color.syntax.function}",
		"method": "${$color.syntax.function}",
		"class": "${$color.syntax.type}",
		"interface": "${$color.syntax.type}",
		"enum": "${$color.syntax.type}",
		"type": "${$color.syntax.type}",
		"string": "${$color.syntax.string}",
		"comment": { "foreground": "${$color.syntax.comment}", "italic": true },
		"parameter": { "italic": true }
	},
	"tokenColors": [
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "support.type.property-name.css",
			"settings": {
				"foreground": "${$color.syntax.property}"
			}
		},
		{
			"scope": [
				"constant.other.symbol",
				"meta.tag",
				"punctuation",
				"template.expression.begin",
				"template.expression.end",
				"text.html.markdown beginning.punctuation.definition.list"
			],
			"settings": {
				"foreground": "${$color.syntax.punctuation}"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "${$color.syntax.emphasis}",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold markup.italic",
				"markup.italic markup.bold"
			],
			"settings": {
				"foreground": "${$color.syntax.emphasis}",
				"fontStyle": "italic bold"
			}
		},
		{
			"scope": [
				"constant.language",
				"entity.name.section.group-title.ini",
				"keyword",
				"markup.heading",
				"modifier",
				"support.type.object",
				"variable.language.this"
			],
			"settings": {
				"foreground": "${$color.syntax.keyword}"
			}
		},
		{
			"scope": [
				"markup.italic",
				"support.module",
				"support.node",
				"variable.parameter.function.language.special.self.python"
			],
			"settings": {
				"foreground": "${$color.syntax.emphasis}",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant.keyword",
				"keyword.control",
				"markup.quote"
			],
			"settings": {
				"foreground": "${$color.syntax.keyword}",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"SXNested",
				"constant.character.escape",
				"markup.fenced_code.block",
				"meta.definition.variable entity.name.function",
				"meta.embedded",
				"meta.function-call.arguments",
				"meta.jsx.children",
				"meta.template.expression",
				"punctuation.definition.entity.html",
				"source.cpp meta.block variable.other",
				"source.cs entity.name.type.namespace",
				"source.groovy.embedded",
				"source.php meta.use support.class",
				"source.php support.other.namespace",
				"support.constant",
				"support.variable",
				"text.html constant.character.entity.named",
				"variable"
			],
			"settings": {
				"foreground": "${$color.syntax.variable}"
			}
		},
		{
			"scope": [
				"constant.other.key",
				"entity.name",
				"entity.other",
				"entity.other.attribute-name.class",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"meta.use",
				"source.cs meta.class.identifier storage.type",
				"source.cs meta.method.return-type",
				"source.cs storage.type",
				"source.css entity.name.tag",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "${$color.syntax.type}"
			}
		},
		{
			"scope": [
				"constant.character.format.placeholder.other.python",
				"constant.numeric",
				"entity.other.attribute-name.id",
				"keyword.other",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "${$color.syntax.number}"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"entity.name.tag",
				"keyword.other.definition.ini",
				"markup.deleted",
				"meta.block",
				"meta.definition.method entity.name.function",
				"meta.field.declaration entity.name.function",
				"meta.link.reference",
				"meta.object-literal.key",
				"meta.object-literal.key string",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"source.cs meta.method.identifier entity.name.function",
				"source.python meta.member.access.python",
				"support.type.property-name.json",
				"text.html.markdown meta.link.inline",
				"variable.object.property"
			],
			"settings": {
				"foreground": "${$color.syntax.tag}"
			}
		},
		{
			"scope": "meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
			"settings": {
				"foreground": "${$color.syntax.namespace}"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function entity.name.function",
				"meta.function-call.arguments",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"source.cs entity.name.function",
				"source.cs meta.method-call meta.method",
				"source.python meta.function-call.python",
				"support.function"
			],
			"settings": {
				"foreground": "${$color.syntax.function}"
			}
		},
		{
			"scope": [
				"constant.language.boolean",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"punctuation.definition.quote"
			],
			"settings": {
				"foreground": "${$color.syntax.constant}"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"meta.structure.dictionary.json support.type.property-name.json",
				"storage.control",
				"storage.modifier",
				"storage.type"
			],
			"settings": {
				"foreground": "${$color.syntax.attribute}"
			}
		},
		{
			"scope": [
				"markup.fenced_code.block.markdown punctuation.definition.markdown",
				"markup.inline.raw.string.markdown",
				"markup.inserted",
				"meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
				"string"
			],
			"settings": {
				"foreground": "${$color.syntax.string}"
			}
		},
		{
			"scope": "source.cs meta.preprocessor",
			"settings": {
				"foreground": "${$color.syntax.preprocessor}"
			}
		},
		{
			"scope": [
				"comment",
				"comment punctuation.definition.comment",
				"punctuation.definition.comment",
				"string.quoted.docstring"
			],
			"settings": {
				"foreground": "${$color.syntax.comment}",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "${$color.state.info}"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "${$color.state.warning}"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "${$color.state.error}"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "${$color.spectrum.purple}"
			}
		}
	]
}
